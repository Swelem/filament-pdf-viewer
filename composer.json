{
    "name": "swelem/filament-pdf-viewer",
    "description": "Enhanced fork of Filament PDF Viewer with PDF.js integration and base64 support (originally by joaopaulolndev)",
    "keywords": [
        "swelem",
        "laravel",
        "filament-pdf-viewer",
        "pdf.js",
        "pdf-viewer",
        "base64-pdf",
        "filament",
        "filament-component",
        "fork",
        "joaopaulolndev"
    ],
    "homepage": "https://github.com/Swelem/filament-pdf-viewer",
    "support": {
        "issues": "https://github.com/Swelem/filament-pdf-viewer/issues",
        "source": "https://github.com/Swelem/filament-pdf-viewer"
    },
    "license": "MIT",
    "readme": "README.md",
    "authors": [
        {
            "name": "Saif Swelem",
            "role": "Developer"
        },
        {
            "name": "João Paulo Leite Nascimento",
            "email": "joaopauloln7@gmail.com",
            "role": "Developer & Original Author"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9|^8.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.1|^3.4.7",
        "pestphp/pest-plugin-arch": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.1.0"
    },
    "autoload": {
        "psr-4": {
            "Swelem\\FilamentPdfViewer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swelem\\FilamentPdfViewer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Swelem\\FilamentPdfViewer\\FilamentPdfViewerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
